rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserEmail() {
      return isAuthenticated() && request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserEmail() == 'davifernandes0024509@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(getUserEmail()))
      );
    }

    function isValidFeedback(data) {
      return data.userId == request.auth.uid &&
             data.messageId is string && data.messageId.size() > 0 &&
             data.chatId is string && data.chatId.size() > 0 &&
             data.utility is int && data.utility >= 1 && data.utility <= 5 &&
             data.clarity is int && data.clarity >= 1 && data.clarity <= 5 &&
             data.creativity is int && data.creativity >= 1 && data.creativity <= 5 &&
             (data.comments == null || (data.comments is string && data.comments.size() <= 1000)) &&
             data.timestamp is string;
    }

    // Admins collection: key is email. 
    match /admins/{email} {
      allow read: if isAuthenticated() && getUserEmail() == email.lower();
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidFeedback(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Users: Keyed by UID. Block client-side modification of isPro, isAdmin, unlimited, adminOverride.
    // Gamification Profiles: Strictly backend-only writes
    match /gamificationProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin() || userId.startsWith("anon_");
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || userId.startsWith('anon_') || isAdmin();
      allow create: if isOwner(userId) || userId.startsWith('anon_');
      allow update: if (isOwner(userId) || userId.startsWith('anon_')) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPro', 'isAdmin', 'unlimited', 'adminOverride']);
    }
    
    // Subscriptions: Allow owner to create (initialize) and read
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || userId.startsWith('anon_') || isAdmin();
      allow create: if isOwner(userId) || userId.startsWith('anon_');
      allow update: if isAdmin(); // Strictly backend/admin for status updates
    }

    // User-owned data with userId field
    match /images/{docId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    match /chats/{docId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    match /memory/{docId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Drafts: docId is prefixed with userId
    match /drafts/{docId} {
      allow read, write: if isAuthenticated() && (docId.startsWith(request.auth.uid) || isAdmin());
    }

    // Internal collections: strictly backend only
    match /config/{docId} { allow read: if true; allow write: if false; }
    match /stripe_webhook_logs/{docId} { allow read, write: if false; }
    match /failed_webhooks/{docId} { allow read, write: if false; }

    match /supportTickets/{ticketId} {
      // Rule 8: Secure List Queries - enforce userId check in the rule itself
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid);
        allow create: if isAuthenticated();
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
