{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information, settings, and subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" },
        "preferences": { "type": "object" },
        "plan": { "type": "string" },
        "subscription": { "type": "object" },
        "usageStats": { "type": "object" }
      },
      "required": ["uid", "email"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "A single conversation session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "lastMessageAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "model": { "type": "string" },
        "isArchived": { "type": "boolean" }
      },
      "required": ["id", "userId", "messages"]
    },
    "GeneratedImage": {
      "title": "Generated Image",
      "description": "Image metadata for the user's library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "prompt": { "type": "string" },
        "timestamp": { "type": "number" },
        "collection": { "type": "string" },
        "isFavorite": { "type": "boolean" }
      }
    },
    "MemoryChunk": {
      "title": "AI Memory Chunk",
      "description": "A piece of information remembered by the AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "metadata": { "type": "object" },
        "embedding": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and settings"
    },
    "/chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Chat history"
    },
    "/images/{imageId}": {
      "schema": "GeneratedImage",
      "description": "Image library"
    },
    "/memory/{memoryId}": {
      "schema": "MemoryChunk",
      "description": "AI Memory"
    },
    "/usage/{userId}": {
      "schema": "object",
      "description": "User daily usage limits and stats"
    },
    "/subscriptions/{userId}": {
      "schema": "object",
      "description": "User subscription details"
    },
    "/subscription_events/{eventId}": {
      "schema": "object",
      "description": "Subscription life-cycle events"
    },
    "/config/admin_settings": {
      "schema": "object",
      "description": "Global admin configuration"
    },
    "/audit_logs/{logId}": {
      "schema": "object",
      "description": "Admin audit logs"
    },
    "/system_logs/{logId}": {
      "schema": "object",
      "description": "System event logs"
    },
    "/stats/global_metrics": {
      "schema": "object",
      "description": "Global usage statistics"
    }
  }
}
